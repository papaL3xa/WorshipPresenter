{
  "name": "worship-presenter",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && npx electron-packager . WorshipPresenter --platform=win32 --arch=x64 --icon=icon.ico --out=release --overwrite --ignore=\"^/(src|public|node_modules|release|scripts|\\.git)\"",
    "electron:installer": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "jimp": "^1.6.1",
    "lucide-react": "^1.27.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "react-youtube": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^6.3.0",
    "globals": "^15.11.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.pisgahbisdac.worshippresenter",
    "productName": "Worship Presenter",
    "copyright": "© 2025 Pisgah Bisdac Multimedia Team",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.ico",
      "icon.png",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Worship Presenter",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeader": "icon.png",
      "license": null,
      "deleteAppDataOnUninstall": false
    }
  }
}
